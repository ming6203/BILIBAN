{
  "manifest_version": 3,
  "name": "BILIBAN - B站用户屏蔽",
  "version": "1.0.0",
  "description": "屏蔽B站指定用户的弹幕、评论、推荐、搜索和动态",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://bilibili.com/*"
      ],
      "js": [
        "content/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://bilibili.com/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/github.js",
        "content/bilibili.js"
      ],
      "css": [
        "content/blocker.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://bilibili.com/*"
      ],
      "js": [
        "content/infinite-scroll.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ]
}